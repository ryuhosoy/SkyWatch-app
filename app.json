{
  "expo": {
    "name": "SkyWatch",
    "slug": "SkyWatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "頭上を飛ぶ航空機を検索するために現在地が必要です。",
        "NSLocationAlwaysUsageDescription": "バックグラウンドでも航空機を追跡するために現在地が必要です。",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ryuhosoy.SkyWatch"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "頭上を飛ぶ航空機を検索するために現在地が必要です。"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00D4FF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "117b43e3-6802-4d5b-9952-80d4d67d8745"
      }
    }
  }
}
